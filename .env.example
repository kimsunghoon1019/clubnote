# 배포(Vercel). 이 값이 있으면 브라우저 localStorage 대신 서버가 원본입니다.

# --- Supabase Postgres (회원·출석·회계·일정 JSON) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 선택. 없으면 SERVICE_ROLE 키로 세션을 서명합니다.
# CLUB_SESSION_SECRET=long-random-string

# --- Cloudflare R2 (영수증·PDF·첨부) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=clubnote
# 관할 리전 버킷이면 예: https://ACCOUNT.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
